# Google Gemini API Key (Required for AI responses)
# Obtain your key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Database URL for Prisma (Online PostgreSQL DB like Supabase, Neon, or Vercel Postgres)
# Example Supabase/Neon PostgreSQL URL:
# DATABASE_URL="postgresql://user:password@ep-cool-db-123456.us-east-2.aws.neon.tech/zyytech_db?sslmode=require"
# Or SQLite for quick local development:
DATABASE_URL="file:./dev.db"

# Secret key for JWT authentication
JWT_SECRET=super_secret_zyytech_jwt_key_12345
